APP_NAME="Camiseta Design"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.camisasdesign.com.br
FRONTEND_URL=https://camisasdesign.com.br

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=camisas_design
DB_USERNAME=usuario_banco
DB_PASSWORD=senha_segura_do_banco

# Armazenamento (public ou r2)
FILESYSTEM_DISK=public

# Cloudflare R2 (Opcional, se FILESYSTEM_DISK=r2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=camisas-design
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_URL=https://pub-<hash>.r2.dev

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contato@camisasdesign.com.br"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=camisasdesign.com.br

# Inteligência Artificial (OpenRouter / Anthropic)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# Evolution API / WhatsApp
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=camiseta-design
EVOLUTION_API_KEY=
WHATSAPP_ADMIN_NUMBER=5581999999999

# Pix Estático (BR Code)
PIX_CHAVE=financeiro@camisasdesign.com.br
PIX_BENEFICIARIO="Camiseta Design"
PIX_CIDADE="SAO PAULO"
VALOR_CREDITO_IA=5.00
