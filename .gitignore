# Dependências
node_modules/
vendor/
backend/vendor/
frontend/node_modules/
frontend/dist/

# Ambientes e Segredos
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local
frontend/.env.production.local

# Arquivos temporários do Laravel
backend/storage/*.key
backend/storage/app/public/
backend/storage/framework/cache/*
